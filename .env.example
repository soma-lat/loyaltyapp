# Public (safe to expose to the browser) — set in Vercel Project Settings → Environment Variables
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Server-only secret — NEVER prefix with NEXT_PUBLIC_. Used only in server
# code (API routes / server actions) for admin tasks like promoting users to
# business_admin / super_admin. Set this in Vercel as a server (non-public)
# environment variable, value copied from Supabase → Project Settings → API.
SUPABASE_SERVICE_ROLE_KEY=eyJ...
